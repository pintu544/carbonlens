# Copy to .env and fill in. NEVER commit .env — testnet key only, no real funds, ever.
# Deployer wallet for Polygon Amoy (generate a fresh one per project; fund via https://faucet.polygon.technology)
DEPLOYER_PRIVATE_KEY=
# Polygon Amoy RPC (public endpoint is fine for testnet; override with your own if rate-limited)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Filled in after `npm run deploy:amoy`
CONTRACT_ADDRESS=
